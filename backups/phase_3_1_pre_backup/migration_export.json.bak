    {
      "id": "us-eb2-niw",
      "country_code": "US",
      "category": "pr",
      "official_name": "EB-2 National Interest Waiver (NIW)",
      "local_language_name": "Employment-Based Second Preference NIW",
      "legal_basis": "Immigration and Nationality Act (INA) § 203(b)(2)(B)(i), 8 CFR 204.5(k) & Matter of Dhanasar, 26 I&N Dec. 884 (AAO 2016)",
      "classification_type": "Actual Immigration Program",
      "eligibility": "Advanced degree (Master's or PhD) or exceptional ability with a proposed endeavor of substantial merit and national importance.",
      "nationality_restrictions": "Open to all nationalities; subject to per-country visa bulletin preference limits (INA § 202).",
      "age_requirements": "18+ principal applicant (no upper age limit)",
      "education_requirements": "U.S. Master's/PhD or foreign equivalent, or Bachelor's + 5 years progressive post-degree experience.",
      "work_experience_requirements": "Demonstrated track record of achievement advancing proposed endeavor.",
      "min_salary_or_income": "No mandatory minimum salary; self-petition allowed without PERM Labor Certification.",
      "investment_requirement": "None",
      "required_funds_and_proof": "Proof of personal financial support during petition processing.",
      "residency_duration": "Permanent Residency (10-Year Renewable Green Card)",
      "renewal_rules": "Renewable indefinitely every 10 years via Form I-90.",
      "pr_or_citizenship_transition": "Eligible for U.S. Citizenship (Form N-400) after 5 years of Lawful Permanent Residence.",
      "family_inclusion_rules": "Includes spouse and unmarried children under 21 years of age under CSPA protection.",
      "work_and_study_rights": "Full unrestricted work and study authorization across the United States.",
      "restrictions_and_exceptions": "Must satisfy all 3 Dhanasar prongs: substantial merit/national importance, well-positioned to advance endeavor, and beneficial to waive job offer requirement.",
      "required_documents_json": "[\"Form I-140\",\"Academic Transcripts & Degrees\",\"Expert Recommendation Letters\",\"Statement of Proposed Endeavor\",\"Citation & Publication Record\"]",
      "documents_and_formats": "PDF filings with certified English translations for non-English documents.",
      "translation_attestation_requirements": "Full certified English translation with translator statement of competence.",
      "application_procedure": "Prepare Form I-140 petition package, file with USCIS processing center, await I-140 adjudication, then file Form I-485 (Adjustment of Status) or Consular Processing.",
      "government_fees": "$715 Form I-140 fee + $300 Asylum Program Fee + optional $2,805 Premium Processing",
      "processing_time": "45 Business Days (Premium Processing) or 6 to 9 Months (Standard)",
      "apply_from": "Both",
      "official_application_url": "https://www.uscis.gov/i-140",
      "official_information_url": "https://www.uscis.gov/working-in-the-united-states/permanent-workers/eb-2-advanced-degree-and-exceptional-ability",
      "source_authority": "U.S. Citizenship and Immigration Services (USCIS)",
      "source_last_updated": "2026-01-15",
      "last_checked_date": "2026-11-10",
      "verification_evidence": "Statutory basis: INA § 203(b)(2)(B)(i); precedent decision: Matter of Dhanasar, 26 I&N Dec. 884 (AAO 2016).",
      "verification_status": "AVAILABLE_VERIFIED",
      "updated_at": "2026-11-10T14:46:14.552Z"
    },
    {
      "id": "us-naturalization-n400",
      "country_code": "US",
      "category": "citizenship",
      "official_name": "U.S. Citizenship by Naturalization (INA Title III)",
      "local_language_name": "United States Statutory Naturalization",
      "legal_basis": "Immigration and Nationality Act (INA) Title III, Section 316 (8 U.S.C. 1427) & 8 CFR Part 316",
      "classification_type": "Administrative Application Procedure",
      "eligibility": "Lawful Permanent Resident for at least 5 years (or 3 years if continuously married to a U.S. citizen), demonstrating continuous residence, physical presence, and good moral character.",
      "nationality_restrictions": "Open to all Lawful Permanent Residents",
      "age_requirements": "18+ at time of filing Form N-400",
      "education_requirements": "None; pass English language & U.S. Civics examination",
      "work_experience_requirements": "None required",
      "min_salary_or_income": "N/A",
      "investment_requirement": "None",
      "required_funds_and_proof": "N/A",
      "residency_duration": "Lifetime U.S. Citizenship",
      "renewal_rules": "Permanent citizenship status; U.S. passport valid for 10 years.",
      "pr_or_citizenship_transition": "Full U.S. Citizenship granted upon Oath of Allegiance.",
      "family_inclusion_rules": "Children under 18 derive citizenship automatically under Child Citizenship Act (CCA) INA § 320.",
      "work_and_study_rights": "Full constitutional rights as a U.S. Citizen.",
      "restrictions_and_exceptions": "Must pass biometrics security check and English/Civics exam (exemptions for 50/20 and 55/15 rules).",
      "required_documents_json": "[\"Form N-400\",\"Permanent Resident Card (Green Card)\",\"Tax Returns (Past 3-5 Years)\",\"State ID / Driver's License\"]",
      "documents_and_formats": "Digital filing via myUSCIS portal.",
      "translation_attestation_requirements": "Certified English translation for foreign civil certificates.",
      "application_procedure": "Submit Form N-400 online via myUSCIS, attend biometrics appointment, pass naturalization interview and civics exam, and take Oath of Allegiance.",
      "government_fees": "$725 ($640 filing fee + $85 biometrics)",
      "processing_time": "5 to 10 Months",
      "apply_from": "Onshore",
      "official_application_url": "https://www.uscis.gov/n-400",
      "official_information_url": "https://www.uscis.gov/citizenship/apply-for-citizenship",
      "source_authority": "U.S. Citizenship and Immigration Services (USCIS)",
      "source_last_updated": "2026-02-01",
      "last_checked_date": "2026-11-10",
      "verification_evidence": "Governed by INA Title III, Section 316 (8 U.S.C. 1427). Form N-400 is the administrative application procedure.",
      "verification_status": "AVAILABLE_VERIFIED",
      "updated_at": "2026-11-10T14:46:14.552Z"
    },
    {
      "id": "us-family-immediate-relative",
      "country_code": "US",
      "category": "family",
      "official_name": "U.S. Family Class - Immediate Relative Immigrant Visa",
      "local_language_name": "Immediate Relative Immigrant Visa (IR-1 / CR-1 / IR-2)",
      "legal_basis": "Immigration and Nationality Act (INA) § 201(b)(2)(A)(i) & 8 CFR § 204.1",
      "classification_type": "Actual Immigration Program",
      "eligibility": "Spouse, unmarried child under 21, or parent of a U.S. citizen (U.S. citizen petitioner must be 21+ for parent sponsorship). No annual statutory caps.",
      "nationality_restrictions": "Open to all nationalities; exempt from per-country numerical limits.",
      "age_requirements": "Petitioner must be 21+ to sponsor parents; no age limit for spouse sponsorship.",
      "education_requirements": "None",
      "work_experience_requirements": "None",
      "min_salary_or_income": "Petitioner must meet 125% of Federal Poverty Guidelines via Form I-864 Affidavit of Support.",
      "investment_requirement": "None",
      "required_funds_and_proof": "Form I-864 Affidavit of Support with U.S. tax returns (W-2s/1040s) and bank statements.",
      "residency_duration": "Permanent Residency (10-Year Green Card, or 2-Year Conditional Green Card if married < 2 years).",
      "renewal_rules": "Renewable indefinitely every 10 years via Form I-90 (or Form I-751 to remove conditions).",
      "pr_or_citizenship_transition": "Eligible for U.S. Citizenship (Form N-400) after 3 years (if married to U.S. citizen) or 5 years.",
      "family_inclusion_rules": "Direct immediate relative classification; stepchildren included if marriage occurred before child turned 18.",
      "work_and_study_rights": "Full unrestricted U.S. employment and study authorization.",
      "restrictions_and_exceptions": "Petitioner must maintain U.S. domicile; beneficiary must clear public charge and medical inadmissibility checks.",
      "required_documents_json": "[\"Form I-130 & I-130A\",\"Marriage / Birth Certificates\",\"Proof of U.S. Citizenship\",\"Form I-864 Affidavit of Support\",\"DS-260 / Form I-485\"]",
      "documents_and_formats": "NVC CEAC digital upload with civil document originals presented at interview.",
      "translation_attestation_requirements": "Certified English translations for foreign civil certificates.",
      "application_procedure": "U.S. citizen files Form I-130 with USCIS, case transfers to National Visa Center (NVC), beneficiary submits DS-260 and attends consular interview.",
      "government_fees": "$675 Form I-130 fee + $325 Immigrant Visa Application Fee + $120 Affidavit of Support Review Fee",
      "processing_time": "10 to 16 Months",
      "apply_from": "Both",
      "official_application_url": "https://www.uscis.gov/i-130",
      "official_information_url": "https://travel.state.gov/content/travel/en/us-visas/immigrate/family-immigration/immigrant-visa-for-a-spouse-or-fiance-of-a-us-citizen.html",
      "source_authority": "USCIS & U.S. Department of State (NVC)",
      "source_last_updated": "2026-02-10",
      "last_checked_date": "2026-11-10",
      "verification_evidence": "Statutory basis: INA § 201(b)(2)(A)(i). Immediate relatives of U.S. citizens are not subject to numerical caps.",
      "verification_status": "AVAILABLE_VERIFIED",
      "updated_at": "2026-11-10T14:46:14.552Z"
    },
    {
      "id": "us-h1b-specialty",
      "country_code": "US",
      "category": "work",
      "official_name": "H-1B Specialty Occupation Worker Visa",
      "local_language_name": "H-1B Nonimmigrant Visa",
      "legal_basis": "Immigration and Nationality Act (INA) § 101(a)(15)(H)(i)(b), 8 CFR 214.2(h)(4)",
      "classification_type": "Residence Permit Subclass",
      "eligibility": "Job offer from a U.S. employer in a specialty occupation requiring a bachelor's degree or higher in a specialized field.",
      "nationality_restrictions": "Open to all nationalities; subject to 85,000 annual statutory cap (65,000 general + 20,000 master's cap).",
      "age_requirements": "18+",
      "education_requirements": "Bachelor's Degree or foreign equivalent in directly related field.",
      "work_experience_requirements": "3 years of relevant experience per missing year of academic education.",
      "min_salary_or_income": "Must meet or exceed prevailing wage set by U.S. Department of Labor (DOL) for MSA occupation code.",
      "investment_requirement": "None",
      "required_funds_and_proof": "Employer DOL LCA approval (Form ETA-9035).",
      "residency_duration": "3 Years initial (extendable up to 6 years total).",
      "renewal_rules": "Extendable beyond 6 years under AC21 §104(c) with approved Form I-140.",
      "pr_or_citizenship_transition": "Dual intent visa; eligible for employer-sponsored Green Card (PERM EB-2/EB-3) or self-petition (EB-1A/EB-2 NIW).",
      "family_inclusion_rules": "Spouse and unmarried children under 21 eligible for H-4 dependent status (H-4 EAD for spouse if I-140 approved).",
      "work_and_study_rights": "Work authorized exclusively for sponsoring H-1B employer.",
      "restrictions_and_exceptions": "Subject to annual March cap lottery unless employer is cap-exempt (universities, non-profit research institutes).",
      "required_documents_json": "[\"Certified Labor Condition Application (ETA-9035)\",\"Approved Form I-797\",\"Form I-129 Petition\",\"Educational Evaluation\"]",
      "documents_and_formats": "USCIS electronic filing and consular DS-160 application.",
      "translation_attestation_requirements": "Certified English translation of foreign academic credentials.",
      "application_procedure": "Employer registers in electronic lottery, receives selection notice, files Labor Condition Application (LCA) with DOL, submits I-129 to USCIS, and employee attends consular visa interview.",
      "government_fees": "$460 base fee + $500 Fraud Prevention + $1,500 ACWIA fee + $2,805 optional Premium Processing",
      "processing_time": "15 Calendar Days (Premium) or 2 to 4 Months (Standard)",
      "apply_from": "Both",
      "official_application_url": "https://www.uscis.gov/i-129",
      "official_information_url": "https://www.uscis.gov/working-in-the-united-states/h-1b-specialty-occupations",
      "source_authority": "USCIS & U.S. Department of Labor (DOL)",
      "source_last_updated": "2026-03-01",
      "last_checked_date": "2026-11-10",
      "verification_evidence": "Statutory basis: INA § 101(a)(15)(H)(i)(b), 8 CFR 214.2(h)(4).",
      "verification_status": "AVAILABLE_VERIFIED",
      "updated_at": "2026-11-10T14:46:14.553Z"
    },
    {
      "id": "us-eb5-investor",
      "country_code": "US",
      "category": "business",
      "official_name": "EB-5 Immigrant Investor Program",
      "local_language_name": "EB-5 Fifth Preference Employment Creation",
      "legal_basis": "Immigration and Nationality Act (INA) § 203(b)(5) & EB-5 Reform and Integrity Act of 2022 (Public Law 117-103)",
      "classification_type": "Actual Immigration Program",
      "eligibility": "Capital investment in a new commercial enterprise (NCE) creating or preserving at least 10 full-time jobs for qualifying U.S. workers.",
      "nationality_restrictions": "Open to all nationalities",
      "age_requirements": "18+",
      "education_requirements": "None",
      "work_experience_requirements": "None",
      "min_salary_or_income": "N/A",
      "investment_requirement": "$800,000 USD (Targeted Employment Area / Rural) or $1,050,000 USD (Standard Area)",
      "required_funds_and_proof": "Comprehensive lawful source and path of funds audit (tax returns, property sales, gift deeds).",
      "residency_duration": "Conditional 2-Year Green Card (Form I-526E), converted to Permanent 10-Year Green Card (Form I-829).",
      "renewal_rules": "Permanent 10-year Green Card granted upon approval of Form I-829.",
      "pr_or_citizenship_transition": "Direct pathway to Permanent Residency and U.S. Citizenship after 5 years.",
      "family_inclusion_rules": "Includes spouse and unmarried children under 21 years of age.",
      "work_and_study_rights": "Full unrestricted U.S. employment and study rights.",
      "restrictions_and_exceptions": "Capital must remain \"at risk\" throughout the conditional residency period.",
      "required_documents_json": "[\"Form I-526E\",\"Lawful Source of Funds Audit\",\"Targeted Employment Area Designation Letter\",\"Comprehensive Business Plan\"]",
      "documents_and_formats": "USCIS Immigrant Investor Program Office (IPO) petition filing.",
      "translation_attestation_requirements": "Certified English translation and banking transfer wire proofs.",
      "application_procedure": "Invest qualifying capital into Regional Center project or direct business, file Form I-526E with USCIS, adjust status or process via U.S. embassy, and file Form I-829 after 2 years.",
      "government_fees": "$11,160 Form I-526E fee + $1,000 Integrity Fund fee",
      "processing_time": "12 to 36 Months",
      "apply_from": "Both",
      "official_application_url": "https://www.uscis.gov/i-526e",
      "official_information_url": "https://www.uscis.gov/working-in-the-united-states/permanent-workers/eb-5-immigrant-investor-program",
      "source_authority": "USCIS Investor Program Office (IPO)",
      "source_last_updated": "2026-01-10",
      "last_checked_date": "2026-11-10",
      "verification_evidence": "Statutory basis: EB-5 Reform and Integrity Act of 2022 (Public Law 117-103), INA § 203(b)(5).",
      "verification_status": "AVAILABLE_VERIFIED",
      "updated_at": "2026-11-10T14:46:14.553Z"
    },
    {
      "id": "us-eb1a-extraordinary",
      "country_code": "US",
      "category": "pr",
      "official_name": "EB-1A Extraordinary Ability Immigrant Visa",
      "local_language_name": "Employment-Based First Preference EB-1A",
      "legal_basis": "Immigration and Nationality Act (INA) § 203(b)(1)(A), 8 CFR § 204.5(h) & Kazarian v. USCIS, 596 F.3d 1115 (9th Cir. 2010)",
      "classification_type": "Actual Immigration Program",
      "eligibility": "Sustained national or international acclaim in sciences, arts, education, business, or athletics. No U.S. employer sponsorship or PERM labor certification required.",
      "nationality_restrictions": "Open to all nationalities; subject to per-country preference limits under INA § 202.",
      "age_requirements": "18+",
      "education_requirements": "No specific degree mandatory if extraordinary achievement is demonstrated via major international award (e.g. Nobel, Oscar) or meeting at least 3 of 10 statutory criteria.",
      "work_experience_requirements": "Extensive documentation of sustained acclaim in field of expertise.",
      "min_salary_or_income": "No fixed statutory minimum, but high salary relative to field satisfies one of 10 criteria.",
      "investment_requirement": "None",
      "required_funds_and_proof": "Evidence of self-support or U.S. prospective work plan.",
      "residency_duration": "Permanent Residency (10-Year Renewable Green Card)",
      "renewal_rules": "Renewable indefinitely every 10 years via Form I-90.",
      "pr_or_citizenship_transition": "Eligible for U.S. Citizenship (Form N-400) after 5 years of Lawful Permanent Residence.",
      "family_inclusion_rules": "Includes spouse and unmarried children under 21 years of age.",
      "work_and_study_rights": "Full unrestricted U.S. employment and study rights.",
      "restrictions_and_exceptions": "Must satisfy Kazarian two-step evaluation: meeting 3/10 criteria plus final merits determination of sustained national/international acclaim.",
      "required_documents_json": "[\"Form I-140\",\"Evidence of Major Award or 3/10 Statutory Criteria\",\"Expert Advisory Letters\",\"Publication & Citation Index\"]",
      "documents_and_formats": "USCIS I-140 petition package.",
      "translation_attestation_requirements": "Certified English translation for foreign documents.",
      "application_procedure": "File Form I-140 self-petition package with USCIS, await adjudication (Premium Processing available), then file Form I-485 or consular processing.",
      "government_fees": "$715 Form I-140 fee + $300 Asylum Program Fee + optional $2,805 Premium Processing",
      "processing_time": "15 Business Days (Premium Processing) or 4 to 8 Months (Standard)",
      "apply_from": "Both",
      "official_application_url": "https://www.uscis.gov/i-140",
      "official_information_url": "https://www.uscis.gov/working-in-the-united-states/permanent-workers/employment-based-immigration-first-preference-eb-1",
      "source_authority": "U.S. Citizenship and Immigration Services (USCIS)",
      "source_last_updated": "2026-02-15",
      "last_checked_date": "2026-11-10",
      "verification_evidence": "Statutory basis: INA § 203(b)(1)(A), 8 CFR § 204.5(h); precedent decision Kazarian v. USCIS (9th Cir. 2010).",
      "verification_status": "AVAILABLE_VERIFIED",
      "updated_at": "2026-11-10T14:46:14.553Z"
    },
    {
      "id": "ca-express-entry",
      "country_code": "CA",
      "category": "pr",
      "official_name": "Express Entry Selection System (IRPA)",
      "local_language_name": "Système d'évaluation Entrée express Canada",
      "legal_basis": "Immigration and Refugee Protection Act (IRPA) S.C. 2001, c. 27 & Ministerial Instructions",
      "classification_type": "Candidate Selection Management System",
      "eligibility": "Candidate management system governing Federal Skilled Worker (FSW), Canadian Experience Class (CEC), and Federal Skilled Trades (FST). Points calculated under Comprehensive Ranking System (CRS).",
      "nationality_restrictions": "Open to all foreign nationals",
      "age_requirements": "18+ (Maximum points awarded between ages 20-29)",
      "education_requirements": "Secondary or post-secondary credentials verified by Educational Credential Assessment (ECA).",
      "work_experience_requirements": "At least 1 year of continuous full-time skilled work experience in TEER 0, 1, 2, or 3.",
      "min_salary_or_income": "Proof of settlement funds (~CAD $14,690 for single applicant) unless working under valid job offer.",
      "investment_requirement": "None",
      "required_funds_and_proof": "Official bank letter following IRCC format showing unencumbered liquid funds.",
      "residency_duration": "Permanent Residency (5-Year Renewable Card)",
      "renewal_rules": "Renewable every 5 years subject to physical presence requirement (730 days in Canada per 5-year block).",
      "pr_or_citizenship_transition": "Eligible for Canadian Citizenship after 1,095 days (3 years) of physical presence.",
      "family_inclusion_rules": "Includes spouse/common-law partner and dependent children under 22 years of age.",
      "work_and_study_rights": "Full unrestricted work and study rights across Canada.",
      "restrictions_and_exceptions": "Category-based draws give priority to French language speakers and specific STEM/healthcare occupations.",
      "required_documents_json": "[\"ECA Report\",\"Language Test Results (IELTS/CELPIP or TEF/TCF)\",\"Police Certificates\",\"Medical Exam\",\"Proof of Funds\"]",
      "documents_and_formats": "PDF digital submission via IRCC online portal.",
      "translation_attestation_requirements": "Certified translation by a certified translator or accompanied by affidavit.",
      "application_procedure": "Create Express Entry profile, receive Invitation to Apply (ITA), submit complete e-APR within 60 days, and receive Confirmation of Permanent Residence (COPR).",
      "government_fees": "CAD $1,365 (PR fee) + CAD $85 biometrics",
      "processing_time": "6 Months (IRCC Standard)",
      "apply_from": "Both",
      "official_application_url": "https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/express-entry.html",
      "official_information_url": "https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/express-entry.html",
      "source_authority": "Immigration, Refugees and Citizenship Canada (IRCC)",
      "source_last_updated": "2026-02-20",
      "last_checked_date": "2026-11-10",
      "verification_evidence": "Express Entry is an online candidate selection system managing FSW, CEC, and FST pathways under IRPA ministerial instructions.",
      "verification_status": "AVAILABLE_VERIFIED",
      "updated_at": "2026-11-10T14:46:14.553Z"
    },
    {
      "id": "ca-family-sponsorship",
      "country_code": "CA",
      "category": "family",
      "official_name": "Canada Family Class - Spouse, Partner & Dependent Child Sponsorship",
      "local_language_name": "Parrainage d'un membre de la catégorie de la famille",
      "legal_basis": "Immigration and Refugee Protection Act (IRPA) S.C. 2001, c. 27, Section 13 & IRPR Part 7",
      "classification_type": "Actual Immigration Program",
      "eligibility": "Canadian citizen or Permanent Resident (18+) sponsoring spouse, common-law partner, conjugal partner, or dependent child under 22 years of age.",
      "nationality_restrictions": "Open to all nationalities",
      "age_requirements": "Sponsor must be 18+; sponsored spouse must be 18+; dependent child under 22.",
      "education_requirements": "None",
      "work_experience_requirements": "None",
      "min_salary_or_income": "No minimum income required for spouse/child sponsorship (unless dependent child has dependent children).",
      "investment_requirement": "None",
      "required_funds_and_proof": "Sponsorship undertaking contract agreeing to provide financial support for 3 years (spouse) or 10 years (child).",
      "residency_duration": "Permanent Residency (5-Year Renewable PR Card)",
      "renewal_rules": "Renewable every 5 years with 730 days residency obligation.",
      "pr_or_citizenship_transition": "Eligible for Canadian Citizenship after 1,095 days of physical residence in Canada.",
      "family_inclusion_rules": "Includes sponsored spouse/partner and dependent children of the sponsored person.",
      "work_and_study_rights": "Open Work Permit eligible (SPOWP) while inland sponsorship is processing.",
      "restrictions_and_exceptions": "5-year sponsorship bar: sponsored spouse cannot sponsor a new spouse within 5 years of becoming PR.",
      "required_documents_json": "[\"Form IMM 1344\",\"Relationship Proof (Photos, Joint Leases, Communication Logs)\",\"Police Certificates\",\"Medical Exam\"]",
      "documents_and_formats": "Digital application via IRCC Permanent Residence Portal.",
