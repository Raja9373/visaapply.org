  sectionNumber: number;
  sectionKey: SectionKey30;
  stageNumber: 1 | 2 | 3 | 4 | 5 | 6;
  legacyCode: string | null;
  title: string;
  shortTitle: string;
  claimSectionLabel: string;
}

