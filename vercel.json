{
  "crons": [
    {
      "path": "/api/cron/immigration-sync",
      "schedule": "30 21 * * *"
    }
  ],
  "functions": {
    "api/render.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/sitemap.ts": {
      "includeFiles": "public/{sitemap.xml,sitemap-index.xml,sitemap_index.xml}"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "visaapply.org"
        }
      ],
      "destination": "https://www.visaapply.org/:path*",
      "permanent": true
    },
    {
      "source": "/in-to-in",
      "destination": "https://www.visaapply.org/immigration/in",
      "permanent": true
    },
    {
      "source": "/in-to-in-:rest*",
      "destination": "https://www.visaapply.org/immigration/in",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://emrldco.com https://tp.media; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://emrldco.com https://*.emrldco.com https://tp.media https://*.tp.media; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://flagcdn.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://emrldco.com https://*.emrldco.com https://tp.media https://*.tp.media; connect-src 'self' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://emrldco.com https://*.emrldco.com https://tp.media https://*.tp.media https://travelpayouts.com https://*.travelpayouts.com https://api.country.is https://ipwho.is https://freeipapi.com https://api.exchangerate-api.com https://open.er-api.com https://api.open-meteo.com; frame-src 'self' https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://ep2.adtrafficquality.google https://www.google.com https://tp.media https://*.tp.media https://c121.travelpayouts.com https://*.travelpayouts.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/sitemap_index.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/sitemap-(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/ai-catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/catalog/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sitemaps-static/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/sitemap-index.xml", "destination": "/sitemap-index.xml" },
    { "source": "/sitemap_index.xml", "destination": "/sitemap_index.xml" },
    { "source": "/sitemap-:sub.xml", "destination": "/sitemap-:sub.xml" },
    { "source": "/sitemaps-static/:path*", "destination": "/sitemaps-static/:path*" },
    { "source": "/catalog/:path*", "destination": "/catalog/:path*" },
    { "source": "/locales/:path*", "destination": "/locales/:path*" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/ai-catalog.json", "destination": "/ai-catalog.json" },
    { "source": "/.well-known/ai-catalog.json", "destination": "/.well-known/ai-catalog.json" },
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/og/:path*", "destination": "/og/:path*" },
    { "source": "/api/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/|assets/|catalog/|locales/|sitemaps-static/|og/|.*\\..*).*)", "destination": "/api/render?path=/$1" }
  ]
}
