function addVisasNoOverwrite(toCode,fromCode,category,visas){
  if(!FULL_VISA_DB[toCode]) FULL_VISA_DB[toCode]={};
  if(!FULL_VISA_DB[toCode][category]) FULL_VISA_DB[toCode][category]=[];
  visas.forEach(nv=>{ if(!FULL_VISA_DB[toCode][category].some(v=>v.id===nv.id)) FULL_VISA_DB[toCode][category].push(nv); });
  if(!FULL_VISA_DB[fromCode]) FULL_VISA_DB[fromCode]={};
  if(!FULL_VISA_DB[fromCode][toCode]) FULL_VISA_DB[fromCode][toCode]={};
  if(!FULL_VISA_DB[fromCode][toCode][category]) FULL_VISA_DB[fromCode][toCode][category]=[];
  visas.forEach(nv=>{ if(!FULL_VISA_DB[fromCode][toCode][category].some(v=>v.id===nv.id)) FULL_VISA_DB[fromCode][toCode][category].push(nv); });
  if(!BASE_COUNTRY_VISAS[toCode]) BASE_COUNTRY_VISAS[toCode]=[];
  visas.forEach(nv=>{ if(!BASE_COUNTRY_VISAS[toCode].some(v=>v.id===nv.id)) BASE_COUNTRY_VISAS[toCode].push(nv); });
}

