const BASE_COUNTRY_VISAS = BASE_COUNTRY_VISAS || {};
const FULL_VISA_DB = FULL_VISA_DB || {};

function addVisasNoOverwrite(toCode, fromCode, category, visas){
  const c = toCode.toLowerCase();
  if(!FULL_VISA_DB[c]) FULL_VISA_DB[c]={};
  if(!FULL_VISA_DB[c][category]) FULL_VISA_DB[c][category]=[];
  if(!BASE_COUNTRY_VISAS[c]) BASE_COUNTRY_VISAS[c]=[];
  if(!FULL_VISA_DB[fromCode]) FULL_VISA_DB[fromCode]={};
  if(!FULL_VISA_DB[fromCode][toCode]) FULL_VISA_DB[fromCode][toCode]={};
  if(!FULL_VISA_DB[fromCode][toCode][category]) FULL_VISA_DB[fromCode][toCode][category]=[];
  visas.forEach(nv=>{
    if(nv.record_type==="SUPPORTING_CLASSIFICATION"||nv.record_type==="LEGACY_VISA") return;
    if(BASE_COUNTRY_VISAS[c].some(v=>v.id===nv.id)) return;
    FULL_VISA_DB[c][category].push(nv);
    FULL_VISA_DB[fromCode][toCode][category].push(nv);
    BASE_COUNTRY_VISAS[c].push(nv);
  });
}

function getLiveVisaCount(code){
  const c = code.toLowerCase();
  if(!BASE_COUNTRY_VISAS[c]) return 0;
  return BASE_COUNTRY_VISAS[c].filter(v=>v.record_type!=="SUPPORTING_CLASSIFICATION"&&v.record_type!=="LEGACY_VISA").length;
}

function getVisasByCategoryFixed(code, cat){
  const c=code.toLowerCase(); const k=cat.toLowerCase();
  if(FULL_VISA_DB[c] && FULL_VISA_DB[c][k] && FULL_VISA_DB[c][k].length>0) return FULL_VISA_DB[c][k];
  if(BASE_COUNTRY_VISAS[c]){
    const f=BASE_COUNTRY_VISAS[c].filter(v=>(v.category===k||v.category===cat)&&v.record_type!=="SUPPORTING_CLASSIFICATION"&&v.record_type!=="LEGACY_VISA");
    if(f.length>0){ if(!FULL_VISA_DB[c]) FULL_VISA_DB[c]={}; FULL_VISA_DB[c][k]=f; return f; }
  }
  return [];
}

