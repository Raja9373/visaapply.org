function autoRebuildAll(){
  Object.keys(BASE_COUNTRY_VISAS||{}).forEach(code=>{
    if(getLiveVisaCount(code)>0 && (!FULL_VISA_DB[code] || Object.keys(FULL_VISA_DB[code]).length===0)){
      if(!FULL_VISA_DB[code]) FULL_VISA_DB[code]={};
      BASE_COUNTRY_VISAS[code].forEach(v=>{
        if(v.record_type==="SUPPORTING_CLASSIFICATION"||v.record_type==="LEGACY_VISA") return;
        const cat=v.category||"tourist";
        if(!FULL_VISA_DB[code][cat]) FULL_VISA_DB[code][cat]=[];
        if(!FULL_VISA_DB[code][cat].some(x=>x.id===v.id)) FULL_VISA_DB[code][cat].push(v);
      });
    }
  });
}
