# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Required password for accessing /admin/* routes and /admin/login.
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# CRON_SECRET: Secret bearer token for authenticating /api/cron/immigration-sync
CRON_SECRET="YOUR_CRON_SECRET"

# NEON_READONLY_DATABASE_URL: Least-privilege read-only Neon pooled URL (role: visaapply_audit_ro).
# Used for public read endpoints and read-only preflight verification.
NEON_READONLY_DATABASE_URL=

# NEON_APP_DATABASE_URL: Least-privilege runtime read/write Neon pooled URL (role: visaapply_app_rw).
# Used for authorized writes, admin updates, and scheduled automation jobs. Never use neondb_owner here.
NEON_APP_DATABASE_URL=

# NEON_MIGRATION_DATABASE_URL: Direct (non-pooled) migration/owner Neon URL for CLI schema migrations ONLY.
# Never configure this variable in Vercel runtime environments.
NEON_MIGRATION_DATABASE_URL=

# NEON_TEST_DATABASE_URL: Isolated Neon PostgreSQL Free-tier test database connection string.
# Do NOT point at production Neon databases.
NEON_TEST_DATABASE_URL=

# DB_DRIVER: Optional explicit local-development override ("postgres" | "sqlite").
# Ignored in production / Vercel where Neon PostgreSQL is strictly required (fail-closed).
DB_DRIVER=postgres
