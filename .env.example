# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Required password for accessing /admin/* routes and /admin/login.
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# CRON_SECRET: Secret bearer token for authenticating /api/cron/immigration-sync
CRON_SECRET="YOUR_CRON_SECRET"

# NEON_TEST_DATABASE_URL: Isolated Neon PostgreSQL Free-tier test database connection string.
# Do NOT replace production DATABASE_URL until Phase 2.10.6 test verification and user cutover approval.
NEON_TEST_DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

